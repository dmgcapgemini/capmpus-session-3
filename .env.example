# Copy to .env.local and adjust. Never commit .env.local.
# Checked by `bun run preflight`; the schema lives in packages/config.

# --- Database ------------------------------------------------------------
# One application file per session; tests derive a separate _test.sqlite file.
# Explicit PostgreSQL uses a separate database with _test appended, created if missing.
DATABASE_URL=sqlite:./.loom/session-03.sqlite
# DATABASE_URL_TEST=sqlite:./.loom/session-03_test.sqlite
# Optional PostgreSQL route (replace the active SQLite URL):
# DATABASE_URL=postgresql://loom:loom-dev@localhost:5432/loom_session03
# DATABASE_URL_TEST=postgresql://loom:loom-dev@localhost:5432/loom_session03_test

# --- API and web ---------------------------------------------------------
LOOM_API_PORT=3000
LOOM_WEB_PORT=5173
LOOM_LOG_LEVEL=info

# --- Workspace sources --------------------------------------------------
# Directory with sources.json; only sources declared there are visible to the agent.
LOOM_SOURCES_DIR=examples/session-03

# --- Copilot -------------------------------------------------------------
# Default: your own `copilot login` is used (client mode copilot-cli). See ADR 0009.

# Optional: use the installed Copilot CLI instead of the runtime bundled with the SDK.
# Needed on macOS, where the bundled runtime cannot read the login stored in the keychain.
# `bun run preflight` tells you when to set it. Example: /opt/homebrew/bin/copilot
# LOOM_COPILOT_CLI_PATH=

# Optional: fine-grained personal access token with the "Copilot Requests" permission.
# When set, Loom uses the server-safe client mode "empty" instead of your login.
# LOOM_GITHUB_TOKEN=

# Optional: model ID; the runtime default is used when empty.
# LOOM_MODEL=

# Session 3 simulated external fleet service (run bun run mock:fms separately).
LOOM_FMS_URL=http://127.0.0.1:3010
# LOOM_FMS_PORT=3010
# LOOM_FMS_DELAY_MS=0
# LOOM_FMS_AGE_SECONDS=0
